# Copy to .env (ignored by Git), fill locally, then run from the repository root:
# set -a; . ./.env; set +a
# python3 -m services.voice_gateway
# This service uses only Python 3's standard library; .env is not auto-loaded.

# Generate your own token, e.g. python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Set the same token in the device's Gateway settings. Minimum 32 ASCII characters.
VOICE_GATEWAY_TOKEN=''
# For separate histories on multiple devices, remove VOICE_GATEWAY_TOKEN and use:
# VOICE_GATEWAY_TOKENS='{"passport-a":"YOUR_UNIQUE_TOKEN_AT_LEAST_32_CHARACTERS","passport-b":"ANOTHER_UNIQUE_TOKEN_AT_LEAST_32_CHARS"}'

DEEPSEEK_API_KEY=''
DEEPSEEK_BASE_URL='https://api.deepseek.com'
DEEPSEEK_MODEL='deepseek-flash'

# Optional Bing public-web search context for gateway-mode answers. This uses
# Bing's public RSS page; the retired Bing Search API is not used. Search
# failures degrade to a normal DeepSeek answer.
BING_SEARCH_ENABLED='0'
BING_SEARCH_URL='https://www.bing.com/search'

# Enable Tencent SentenceRecognition. Keep postpaid disabled for free-quota-only use.
TENCENT_SECRET_ID=''
# ASR_API_KEY is the corresponding Tencent SecretKey.
ASR_API_KEY=''
ASR_BASE_URL='https://asr.tencentcloudapi.com'
ASR_MODEL='16k_zh'

# Set 0.0.0.0 to allow the device on your trusted Wi-Fi to connect to this computer.
# Use http://COMPUTER_LAN_IP:8765 in device settings. Do not port-forward this server.
# For untrusted networks, terminate HTTPS at a trusted reverse proxy.
VOICE_GATEWAY_HOST='127.0.0.1'
VOICE_GATEWAY_PORT='8765'
# Persistent transcript/reply history: last 12 turns sent as context, 128 retained.
# Audio is never stored. DELETE /v1/memory clears the authenticated device only.
VOICE_GATEWAY_MEMORY_DB='~/.local/share/ai-passport/voice-memory.sqlite3'
